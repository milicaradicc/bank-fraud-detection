package rules.templates;
import com.ftn.sbnz.model.events.Transaction;
import com.ftn.sbnz.model.facts.Client;
import com.ftn.sbnz.model.facts.Flag;
import com.ftn.sbnz.model.enums.FlagType;
import com.ftn.sbnz.model.enums.TransactionChannel;
import java.util.Date;

rule "Country Origin_2"
salience 100
when
    $tx: Transaction(
        $clientId: clientId,
        $txId: transactionId,
        country == "KP",
        $time: timestamp
    )
    Client(clientId == $clientId)
    not Flag(transactionId == $txId, type == FlagType.RIZICNA_LOKACIJA)
then
    Flag flag = new Flag($clientId, $txId, FlagType.RIZICNA_LOKACIJA, $time,
        "Transakcija iz zemlje (crna lista): KP, tezina 40");
    flag.setWeight(40);
    insert(flag);
    System.out.println("[TEMPLATE-COUNTRY] Origin KP (crna): " + flag);
end
rule "Country Recipient_2"
salience 100
when
    $tx: Transaction(
        $clientId: clientId,
        $txId: transactionId,
        channel == TransactionChannel.TRANSFER,
        recipientCountry == "KP",
        $time: timestamp
    )
    Client(clientId == $clientId)
    not Flag(transactionId == $txId, type == FlagType.RIZICAN_PRIMALAC)
then
    Flag flag = new Flag($clientId, $txId, FlagType.RIZICAN_PRIMALAC, $time,
        "Primalac u zemlji (crna lista): KP, tezina 40");
    flag.setWeight(40);
    insert(flag);
    System.out.println("[TEMPLATE-COUNTRY] Recipient KP (crna): " + flag);
end

