package rules.templates;
import com.ftn.sbnz.model.facts.Client;
import com.ftn.sbnz.model.facts.RiskScore;
import com.ftn.sbnz.model.enums.ClientSegment;
import com.ftn.sbnz.model.enums.RiskLevel;

rule "Risk Thresholds_2"
salience 48
no-loop true
when
    $client: Client(segment == ClientSegment.VIP)
    $rs: RiskScore(clientId == $client.clientId, $score: score)
then
    RiskLevel newLevel;
    if ($score >= 90) {
        newLevel = RiskLevel.CRITICAL;
    } else if ($score >= 70) {
        newLevel = RiskLevel.HIGH;
    } else if ($score >= 35) {
        newLevel = RiskLevel.MEDIUM;
    } else {
        newLevel = RiskLevel.LOW;
    }
    if (newLevel != $rs.getLevel()) {
        modify($rs) { setLevel(newLevel) }
        System.out.println("[TEMPLATE] Segment VIP prag primenjen: " + $score + " -> " + newLevel);
    }
end

